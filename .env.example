# .env.example
# Reference list of all Script Properties used by this project.
# In Google Apps Script, set these under:
#   Extensions > Apps Script > Project Settings > Script Properties
#
# No real values belong here or anywhere in this repository.
# This file uses placeholder values only.

# ── Google Sheets ────────────────────────────────────────────────────────────
# SPREADSHEET_ID: from the spreadsheet URL (/spreadsheets/d/<ID>/)
SPREADSHEET_ID=your_spreadsheet_id_here
BOOKINGS_SHEET_NAME=Bookings

# ── SendGrid ──────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=Your Company Name

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
STRIPE_PRICE_ID=price_your_price_id_here
STRIPE_SUCCESS_URL=https://yourdomain.com/payment-success
STRIPE_CANCEL_URL=https://yourdomain.com/payment-cancel

# ── DocuSeal ──────────────────────────────────────────────────────────────────
DOCUSEAL_API_KEY=your_docuseal_api_key_here
DOCUSEAL_BASE_URL=https://api.docuseal.com
DOCUSEAL_TEMPLATE_ID=your_docuseal_template_id_here

# ── Notifications ─────────────────────────────────────────────────────────────
# Internal address that receives all booking and status-change notifications.
NOTIFICATION_EMAIL=your_notification_email@example.com

# ── Business ──────────────────────────────────────────────────────────────────
# COMPANY_NAME appears in all outbound customer email signatures.
# Falls back to 'Reliable Storage' if not set.
COMPANY_NAME=Your Company Name

# LOCK_CUT_FEE is displayed to customers in lock-cut payment/signature emails.
# Falls back to '$50' if not set.
LOCK_CUT_FEE=$50

# ── Pipedream ─────────────────────────────────────────────────────────────────
# Shared secret used to authenticate incoming Pipedream webhook payloads.
# Must match GAS_PIPEDREAM_SECRET in Pipedream Environment Variables exactly.
PIPEDREAM_SECRET=your_strong_random_secret_here

# ── Location routing ──────────────────────────────────────────────────────────
# Fallback values used when the bookingSource field sent by Pipedream does not
# match any key in CONFIG.LOCATION_MAP in Config.gs.
DEFAULT_LOCATION=your_default_location_here
DEFAULT_LOCATION_GROUP=your_default_location_group_here

# ── Intake Form ───────────────────────────────────────────────────────────────
# INTAKE_FORM_PUBLIC_ID: from the form's shareable URL (/d/e/<ID>/viewform)
# INTAKE_FORM_EDIT_ID:   from the form editor URL (/d/<ID>/edit)
INTAKE_FORM_PUBLIC_ID=your_form_public_id_here
INTAKE_FORM_EDIT_ID=your_form_edit_id_here

# ── Intake Form Field Entry IDs ───────────────────────────────────────────────
# Find entry IDs via Google Form > ⋮ > Get pre-filled link > fill dummy values
# > copy the resulting URL > read the entry.XXXXXXXXX query parameters.
INTAKE_FORM_FIELD_FULL_NAME=entry.XXXXXXXXX
INTAKE_FORM_FIELD_PHONE_NUMBER=entry.XXXXXXXXX
INTAKE_FORM_FIELD_UNIT_NUMBER=entry.XXXXXXXXX
INTAKE_FORM_FIELD_EMAIL=entry.XXXXXXXXX
INTAKE_FORM_FIELD_REQUEST_TYPE=entry.XXXXXXXXX
INTAKE_FORM_FIELD_NOTES=entry.XXXXXXXXX
INTAKE_FORM_FIELD_LOCATION=entry.XXXXXXXXX
